---
kind: Secret
apiVersion: v1
metadata:
  name: vault-api-secret
  namespace: llama-stack
  labels:
    app.kubernetes.io/instance: vault-api-secret
data:
  # Base64 encoded OAuth credentials - replace with your actual values
  # To encode: echo -n "your-value" | base64
  client-id: YOUR_CLIENT_ID_BASE64
  client-secret: YOUR_CLIENT_SECRET_BASE64
  scope: YOUR_SCOPE_BASE64
  vault-url: YOUR_VAULT_URL_BASE64
type: Opaque
